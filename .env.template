JWT_SECRET=something
COOKIE_SECRET=something

DATABASE_TYPE="postgres"
REDIS_URL=redis://localhost:6379

# AI Cake Studio — image generation. Switch AI_IMAGE_PROVIDER to "openai" or
# "gemini" (and set the matching key) to A/B test against Replicate/FLUX —
# no other code changes needed.
AI_IMAGE_PROVIDER=replicate
AI_IMAGE_MODEL=black-forest-labs/flux-1.1-pro
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=

# AI Cake Studio — horoscope quote generation (decorative only; if unset,
# the quote is silently skipped and image generation is unaffected)
ANTHROPIC_API_KEY=

# AI Cake Studio — reference-image vision analysis (backend-only, no
# customer-facing picker). Reuses ANTHROPIC_API_KEY/OPENAI_API_KEY above —
# no separate key needed either way.
VISION_PROVIDER=anthropic
VISION_MODEL=claude-haiku-4-5-20251001

# ── Baker Portal ─────────────────────────────────────────────────────────────
# Signs baker_session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# MUST differ from JWT_SECRET and from OPS's SESSION_SECRET — the three identities
# (customer / OPS / baker) are kept apart by these keys being distinct values.
BAKER_SESSION_SECRET=

# Shared secret proving a caller is the OPS application. Must match OPS_SERVICE_KEY
# in crossfriend-ops. Generate with the same command as above.
OPS_SERVICE_KEY=
